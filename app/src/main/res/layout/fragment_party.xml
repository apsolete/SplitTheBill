<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutParty"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.party.PartyFragment">

    <TextView
        android:id="@+id/textTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:autofillHints="Title"
        android:ems="10"
        android:hint="@string/party_title"
        app:layout_constraintBottom_toTopOf="@id/textWhere"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/textWhere"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:autofillHints="Where"
        android:ems="10"
        android:hint="@string/party_where"
        app:layout_constraintBottom_toTopOf="@id/textWhenDate"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textTitle" />

    <TextView
        android:id="@+id/textWhenDate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:autofillHints="When date"
        android:ems="10"
        android:hint="@string/party_when_date"
        app:layout_constraintBottom_toTopOf="@id/textWhenTime"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textWhere" />

    <TextView
        android:id="@+id/textWhenTime"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:autofillHints="When time"
        android:ems="10"
        android:hint="@string/party_when_time"
        app:layout_constraintBottom_toTopOf="@id/recyclerPartyGoers"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textWhenDate" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerPartyGoers"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:padding="@dimen/big_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textWhenTime"
        tools:listitem="@layout/recyclerview_mate" />

</androidx.constraintlayout.widget.ConstraintLayout>
