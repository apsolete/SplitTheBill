<?xml version="1.0" encoding="utf-8"?>
<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_party">

    <fragment
        android:id="@+id/navigation_party"
        android:name="com.apsolete.splitthebill.ui.party.PartyFragment"
        android:label="@string/title_party"
        tools:layout="@layout/fragment_party">
        <action
            android:id="@+id/action_party_to_mate"
            app:destination="@id/navigation_mate"/>
    </fragment>

    <fragment
        android:id="@+id/navigation_mate"
        android:name="com.apsolete.splitthebill.ui.mate.MateFragment"
        android:label="@string/title_mate"
        tools:layout="@layout/fragment_mate" />

    <fragment
        android:id="@+id/navigation_bill"
        android:name="com.apsolete.splitthebill.ui.bill.BillFragment"
        android:label="@string/title_bill"
        tools:layout="@layout/fragment_bill" />

    <fragment
        android:id="@+id/navigation_split"
        android:name="com.apsolete.splitthebill.ui.split.SplitFragment"
        android:label="@string/title_split"
        tools:layout="@layout/fragment_split" />
</navigation>